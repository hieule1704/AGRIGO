router.get('/machines', async (req, res) => {
  const filter = {};
  if (req.query.status) filter.status = req.query.status;
  const machines = await Machine.find(filter)
    .populate('category_id', 'name')
    .populate('owner_id', 'full_name email phone')
    .sort({ created_at: -1 });
  res.json({ machines });
});

