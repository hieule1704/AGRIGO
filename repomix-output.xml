import { useEffect, useState } from 'react';
import { useSearchParams, Link } from 'react-router-dom';
import { api } from '../api';
import { categoryIcon, formatVND } from '../components/MachineCard';
import MachineMap from '../components/MachineMap';

const DISTRICTS = ['Long Xuyên', 'Châu Đốc', 'Châu Phú', 'Châu Thành', 'Chợ Mới', 'Phú Tân', 'Tân Châu', 'Thoại Sơn', 'Tri Tôn', 'Tịnh Biên'];

const DISTRICT_CENTERS = {
  'Long Xuyên': [10.3833, 105.4167],
  'Châu Đốc': [10.7000, 105.1167],
  'Châu Phú': [10.5500, 105.1333],
  'Chợ Mới': [10.4500, 105.5333],
  'Thoại Sơn': [10.2833, 105.2333],
  'Tri Tôn': [10.4167, 105.0000],
  'Phú Tân': [10.6333, 105.3500],
  'Tân Châu': [10.8000, 105.2333],
  'Tịnh Biên': [10.6000, 104.9500],
  'Châu Thành': [10.4333, 105.3167],
};

export default function Search() {
  const [params, setParams] = useSearchParams();
  const [categories, setCategories] = useState([]);
  const [machines, setMachines] = useState([]);
  const [loading, setLoading] = useState(true);
  const [viewMode, setViewMode] = useState('split'); // 'split' | 'list' | 'map'

  const district = params.get('district') || '';
  const category = params.get('category') || '';
  const date = params.get('date') || '';
  const sort = params.get('sort') || 'newest';

  useEffect(() => {
    api.get('/categories').then((d) => setCategories(d.categories));
  }, []);

  useEffect(() => {
    setLoading(true);
    const q = new URLSearchParams();
    if (district) q.set('district', district);
    if (category) q.set('category', category);
    if (date) q.set('date', date);
    if (sort) q.set('sort', sort);
    api.get(`/machines?${q.toString()}`)
      .then((d) => setMachines(d.machines))
      .finally(() => setLoading(false));
  }, [district, category, date, sort]);

  function updateParam(key, value) {
    const next = new URLSearchParams(params);
    if (value) next.set(key, value); else next.delete(key);
    setParams(next);
  }

  const mapCenter = DISTRICT_CENTERS[district] || null;

  return (
    <div className="container" style={{ paddingTop: 26, paddingBottom: 40 }}>
      <form className="search-card" style={{ marginBottom: 20 }} onSubmit={(e) => e.preventDefault()}>
        <div className="search-field">
          <label>Khu vực</label>
          <select value={district} onChange={(e) => updateParam('district', e.target.value)}>
            <option value="">Tất cả khu vực</option>
            {DISTRICTS.map((d) => <option key={d} value={d}>{d}</option>)}
          </select>
        </div>
        <div className="search-field">
          <label>Loại máy</label>
          <select value={category} onChange={(e) => updateParam('category', e.target.value)}>
            <option value="">Tất cả loại máy</option>
            {categories.map((c) => <option key={c._id} value={c._id}>{c.name}</option>)}
          </select>
        </div>
        <div className="search-field">
          <label>Ngày cần dùng</label>
          <input type="date" value={date} onChange={(e) => updateParam('date', e.target.value)} />
        </div>
        <button className="btn btn-primary" type="button" onClick={() => {}}>🔍 Tìm kiếm</button>
      </form>

      {/* Thanh điều khiển Chế độ xem: Danh sách / Bản đồ / Song song */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20, background: 'var(--bg-card)', padding: '10px 16px', borderRadius: 12, border: '1px solid var(--line)' }}>
        <div>
          <span className="small" style={{ color: 'var(--muted)' }}>Tìm thấy <b>{machines.length}</b> máy nông nghiệp</span>
        </div>
        <div style={{ display: 'flex', gap: 6 }}>
          <button
            type="button"
            className={`btn btn-sm ${viewMode === 'split' ? 'btn-primary' : 'btn-outline'}`}
            onClick={() => setViewMode('split')}
          >
            ⚖️ Song song
          </button>
          <button
            type="button"
            className={`btn btn-sm ${viewMode === 'list' ? 'btn-primary' : 'btn-outline'}`}
            onClick={() => setViewMode('list')}
          >
            📋 Danh sách
          </button>
          <button
            type="button"
            className={`btn btn-sm ${viewMode === 'map' ? 'btn-primary' : 'btn-outline'}`}
            onClick={() => setViewMode('map')}
          >
            🗺 Bản đồ Leaflet
          </button>
        </div>
      </div>

      <div className="search-layout">
        <aside className="filter-box">
          <h4>Sắp xếp</h4>
          <div className="filter-group">
            <a href="#" className="opt small" style={{ display: 'block', padding: '6px 0', fontWeight: sort === 'newest' ? 700 : 400 }} onClick={(e) => { e.preventDefault(); updateParam('sort', 'newest'); }}>Mới nhất</a>
            <a href="#" className="opt small" style={{ display: 'block', padding: '6px 0', fontWeight: sort === 'price_asc' ? 700 : 400 }} onClick={(e) => { e.preventDefault(); updateParam('sort', 'price_asc'); }}>Giá thấp → cao</a>
            <a href="#" className="opt small" style={{ display: 'block', padding: '6px 0', fontWeight: sort === 'rating' ? 700 : 400 }} onClick={(e) => { e.preventDefault(); updateParam('sort', 'rating'); }}>Đánh giá cao nhất</a>
          </div>
        </aside>

        <div style={{ flex: 1, minWidth: 0 }}>
          {loading && <p>Đang tải dữ liệu máy...</p>}

          {!loading && (
            <>
              {/* CHẾ ĐỘ XEM 1: CHỈ BẢN ĐỒ */}
              {viewMode === 'map' && (
                <div>
                  <MachineMap machines={machines} center={mapCenter} zoom={district ? 12 : 10} height="600px" />
                </div>
              )}

              {/* CHẾ ĐỘ XEM 2: SONG SONG (Bản đồ + Danh sách) */}
              {viewMode === 'split' && (
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
                  <div style={{ position: 'sticky', top: 80, height: 'calc(100vh - 120px)' }}>
                    <MachineMap machines={machines} center={mapCenter} zoom={district ? 12 : 10} height="100%" />
                  </div>
                  <div className="results-list" style={{ overflowY: 'auto', maxHeight: 'calc(100vh - 120px)', paddingRight: 4 }}>
                    {machines.length === 0 ? (
                      <div className="empty-state"><div className="ico">🔍</div>Không tìm thấy máy phù hợp.</div>
                    ) : (
                      machines.map((m) => <MachineRow key={m._id} machine={m} compact={true} />)
                    )}
                  </div>
                </div>
              )}

              {/* CHẾ ĐỘ XEM 3: CHỈ DANH SÁCH */}
              {viewMode === 'list' && (
                <div className="results-list">
                  {machines.length === 0 ? (
                    <div className="empty-state"><div className="ico">🔍</div>Không tìm thấy máy phù hợp. Hãy thử đổi bộ lọc.</div>
                  ) : (
                    machines.map((m) => <MachineRow key={m._id} machine={m} />)
                  )}
                </div>
              )}
            </>
          )}
        </div>
      </div>
    </div>
  );
}

// Component render 1 dòng máy nông nghiệp
function MachineRow({ machine: m, compact = false }) {
  const cat = m.category_id || {};
  return (
    <Link to={`/machine/${m._id}`} className={`result-row ${compact ? 'compact' : ''}`}>
      <div className="thumb">
        {m.image_url ? <img src={m.image_url} alt={m.name} /> : categoryIcon(cat.slug)}
      </div>
      <div className="mid">
        <div className="cat">{cat.name}</div>
        <h3>{m.name}</h3>
        <div className="loc">📍 {m.district}{m.address_detail ? ' · ' + m.address_detail : ''}</div>
        {!compact && <div className="desc">{(m.description || '').slice(0, 110)}...</div>}
        <div className="tag-row">
          {m.brand && <span className="tag">{m.brand}</span>}
          {m.year_made && <span className="tag">Đời {m.year_made}</span>}
        </div>
      </div>
      <div className="right">
        <div className="rating">
          {m.rating_count > 0
            ? <><span className="star">★</span> {Number(m.rating_avg).toFixed(1)} ({m.rating_count})</>
            : <span className="small">Chưa đánh giá</span>}
        </div>
        <div>
          <div className="price">{formatVND(m.price_per_day)} <span className="small">/ {m.price_unit}</span></div>
        </div>
        <span className="btn btn-primary btn-sm">Xem & đặt</span>
      </div>
    </Link>
  );
}
</file>

<file path="frontend/src/styles.css">
/* ============================================================
   AGRIGO — He thong thiet ke
   Bang mau lay cam hung tu canh dong lua An Giang:
   xanh la dam (mau, sam), vang lua chin (accent),
   xanh nuoc phu sa (thu cap), nen giay lua nhat.
   ============================================================ */

:root{
  --green-deep:#153A2E;
  --green-mid:#1F5C45;
  --green-soft:#E6EFE7;
  --gold:#E8AC1F;
  --gold-dark:#B9840C;
  --teal:#2C7A7B;
  --paper:#FBF8F1;
  --card:#FFFFFF;
  --ink:#1B211D;
  --ink-soft:#5B6660;
  --line:#E4DFCF;
  --danger:#C1432D;
  --radius-lg:18px;
  --radius-md:12px;
  --radius-sm:8px;
  --shadow-card:0 2px 10px rgba(21,58,46,0.08);
  --shadow-pop:0 10px 30px rgba(21,58,46,0.18);
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Be Vietnam Pro',system-ui,sans-serif;
  background:var(--paper);
  color:var(--ink);
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none;}
img{max-width:100%;display:block;}
button{font-family:inherit;cursor:pointer;}
.container{max-width:1180px;margin:0 auto;padding:0 20px;}

/* ---------- Topbar ---------- */
.topbar{
  background:var(--green-deep);
  color:#fff;
  font-size:12.5px;
}
.topbar .container{display:flex;justify-content:space-between;align-items:center;height:34px;}
.topbar .muted{opacity:.75;}
.topbar a{opacity:.9;}
.topbar a:hover{opacity:1;text-decoration:underline;}

/* ---------- Header / Nav ---------- */
.header{
  background:#fff;
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:50;
}
.header .container{display:flex;align-items:center;gap:24px;height:72px;}
.logo{display:flex;align-items:center;gap:9px;font-weight:800;font-size:22px;color:var(--green-deep);letter-spacing:-0.02em;flex-shrink:0;}
.logo .mark{
  width:34px;height:34px;border-radius:9px;
  background:linear-gradient(160deg,var(--green-mid),var(--green-deep));
  display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:18px;
}
.nav-links{display:flex;gap:22px;font-weight:600;font-size:14.5px;color:var(--ink);flex:1;}
.nav-links a{padding:8px 0;border-bottom:2px solid transparent;}
.nav-links a:hover, .nav-links a.active{border-color:var(--gold);color:var(--green-deep);}
.header-actions{display:flex;align-items:center;gap:10px;flex-shrink:0;}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:10px 18px;border-radius:999px;border:1px solid transparent;
  font-weight:700;font-size:14px;transition:.15s ease;white-space:nowrap;
}
.btn-primary{background:var(--gold);color:var(--green-deep);}
.btn-primary:hover{background:var(--gold-dark);}
.btn-outline{border-color:var(--line);color:var(--ink);background:#fff;}
.btn-outline:hover{border-color:var(--green-deep);}
.btn-ghost{color:var(--green-deep);font-weight:700;}
.btn-ghost:hover{text-decoration:underline;}
.btn-block{width:100%;}
.btn-sm{padding:7px 14px;font-size:13px;}
.btn-danger{background:#fbe8e4;color:var(--danger);}
.btn-danger:hover{background:#f6d3cc;}
.btn:disabled{opacity:.5;cursor:not-allowed;}

/* ---------- Hero ---------- */
.hero{
  position:relative;
  background:
    repeating-linear-gradient(115deg, rgba(255,255,255,0.05) 0 26px, rgba(255,255,255,0) 26px 52px),
    linear-gradient(120deg,var(--green-deep) 0%,var(--green-mid) 55%, #2E6E52 100%);
  color:#fff;
  padding:56px 0 108px;
  overflow:hidden;
}
.hero::after{
  content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(90deg, rgba(232,172,31,0.07) 0 3px, transparent 3px 46px);
  pointer-events:none;
}
.hero-inner{position:relative;z-index:1;}
.hero .eyebrow{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.25);
  padding:6px 14px;border-radius:999px;font-size:12.5px;font-weight:600;margin-bottom:18px;
}
.hero h1{font-size:42px;font-weight:800;letter-spacing:-0.02em;max-width:640px;margin:0 0 12px;}
.hero p.lead{font-size:16.5px;opacity:.88;max-width:560px;margin:0 0 30px;}

/* Search card */
.search-card{
  background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-pop);
  padding:18px;display:grid;grid-template-columns:1.3fr 1fr 1fr auto;gap:12px;align-items:end;
}
.search-field label{display:block;font-size:11.5px;font-weight:700;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;}
.search-field select,.search-field input{
  width:100%;border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:11px 12px;font-size:14.5px;font-family:inherit;color:var(--ink);background:#fff;
}
.search-field select:focus,.search-field input:focus{outline:2px solid var(--gold);outline-offset:1px;}
.search-card .btn{height:44px;padding:0 26px;}

/* stat strip below hero search */
.hero-stats{display:flex;gap:36px;margin-top:26px;font-size:13.5px;}
.hero-stats b{font-size:22px;display:block;color:var(--gold);font-weight:800;}

/* ---------- Section shell ---------- */
.section{padding:52px 0;}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:26px;gap:16px;}
.section-head h2{font-size:26px;font-weight:800;margin:0 0 6px;letter-spacing:-0.01em;}
.section-head p{margin:0;color:var(--ink-soft);font-size:14.5px;}
.eyebrow-label{font-size:12px;font-weight:700;color:var(--teal);text-transform:uppercase;letter-spacing:.08em;margin:0 0 6px;}

/* ---------- Category grid ---------- */
.cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-top:-70px;position:relative;z-index:2;}
.cat-card{
  background:#fff;border-radius:var(--radius-md);border:1px solid var(--line);
  padding:18px 12px;text-align:center;box-shadow:var(--shadow-card);transition:.15s;
}
.cat-card:hover{transform:translateY(-3px);border-color:var(--gold);}
.cat-card .ico{
  width:46px;height:46px;border-radius:50%;background:var(--green-soft);color:var(--green-deep);
  display:flex;align-items:center;justify-content:center;margin:0 auto 10px;font-size:22px;
}
.cat-card .name{font-weight:700;font-size:13.5px;}

/* ---------- Machine cards ---------- */
.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.machine-card{
  background:var(--card);border:1px solid var(--line);border-radius:var(--radius-md);
  overflow:hidden;box-shadow:var(--shadow-card);transition:.15s;display:flex;flex-direction:column;
}
.machine-card:hover{box-shadow:var(--shadow-pop);transform:translateY(-2px);}
.machine-card .thumb{
  aspect-ratio:4/3;background:linear-gradient(135deg,var(--green-soft),#f2ead0);
  display:flex;align-items:center;justify-content:center;font-size:38px;color:var(--green-mid);position:relative;
}
.machine-card .thumb img{width:100%;height:100%;object-fit:cover;}
.badge{
  position:absolute;top:10px;left:10px;background:#fff;border-radius:999px;padding:4px 10px;
  font-size:11px;font-weight:700;color:var(--green-deep);box-shadow:var(--shadow-card);
}
.badge-gold{background:var(--gold);color:var(--green-deep);}
.machine-card .body{padding:14px 14px 16px;flex:1;display:flex;flex-direction:column;gap:6px;}
.machine-card .cat{font-size:11.5px;font-weight:700;color:var(--teal);text-transform:uppercase;letter-spacing:.03em;}
.machine-card h3{font-size:15.5px;margin:0;font-weight:700;line-height:1.3;}
.machine-card .loc{font-size:12.5px;color:var(--ink-soft);display:flex;align-items:center;gap:5px;}
.rating{font-size:12.5px;font-weight:700;color:var(--green-deep);display:flex;align-items:center;gap:4px;}
.rating .star{color:var(--gold-dark);}
.price-row{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:10px;border-top:1px dashed var(--line);}
.price{font-size:17px;font-weight:800;color:var(--green-deep);}
.price small{font-size:11.5px;font-weight:500;color:var(--ink-soft);}

/* ---------- Search page layout ---------- */
.search-layout{display:grid;grid-template-columns:260px 1fr;gap:26px;align-items:start;}
.filter-box{background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:18px;position:sticky;top:88px;}
.filter-box h4{margin:0 0 12px;font-size:14px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);}
.filter-group{margin-bottom:18px;}
.filter-group label.opt{display:flex;align-items:center;gap:8px;font-size:14px;padding:5px 0;}
.results-list{display:flex;flex-direction:column;gap:14px;}
.result-row{
  display:grid;grid-template-columns:180px 1fr auto;gap:16px;
  background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:14px;box-shadow:var(--shadow-card);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  align-items: start;
}
.result-row:hover{transform:translateY(-2px);box-shadow:var(--shadow-pop);}
.result-row .thumb{
  border-radius:var(--radius-sm);aspect-ratio:4/3;overflow:hidden;
  background:linear-gradient(135deg,var(--green-soft),#f2ead0);
  display:flex;align-items:center;justify-content:center;font-size:36px;
}
.result-row .thumb img{width:100%;height:100%;object-fit:cover;}
.result-row .mid{min-width:0;}
.result-row .mid .cat{font-size:11.5px;font-weight:700;color:var(--teal);text-transform:uppercase;margin-bottom:2px;}
.result-row .mid h3{margin:0 0 4px;font-size:16px;font-weight:700;line-height:1.3;color:var(--ink);word-break:break-word;}
.result-row .mid .loc{font-size:12.5px;color:var(--ink-soft);margin-bottom:4px;}
.result-row .mid .desc{color:var(--ink-soft);font-size:13px;margin:4px 0;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.result-row .right{
  display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end;
  text-align:right;min-width:130px;flex-shrink:0;height:100%;gap:10px;
}

/* Kiểu dáng gọn gàng chuẩn xác cho chế độ xem Song song (Split view) */
.result-row.compact{
  grid-template-columns: 110px 1fr;
  gap: 12px;
  padding: 12px;
}
.result-row.compact .thumb{
  aspect-ratio: 1/1;
  font-size: 28px;
}
.result-row.compact .mid h3{
  font-size: 14.5px;
}
.result-row.compact .mid .desc{
  display: none;
}
.result-row.compact .right{
  grid-column: 1 / -1;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  border-top: 1px dashed var(--line);
  padding-top: 8px;
  margin-top: 4px;
  text-align: left;
}

.tag-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px;}
.tag{background:var(--green-soft);color:var(--green-deep);font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:999px;}

/* ---------- Machine detail ---------- */
.detail-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:30px;align-items:start;}
.detail-gallery{border-radius:var(--radius-lg);overflow:hidden;aspect-ratio:16/9;background:linear-gradient(135deg,var(--green-soft),#f2ead0);display:flex;align-items:center;justify-content:center;font-size:60px;color:var(--green-mid);}
.detail-gallery img{width:100%;height:100%;object-fit:cover;}
.spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;margin:18px 0;}
.spec-item{border-bottom:1px solid var(--line);padding-bottom:8px;}
.spec-item .k{font-size:12px;color:var(--ink-soft);}
.spec-item .v{font-weight:700;font-size:14.5px;}
.booking-box{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:20px;position:sticky;top:88px;box-shadow:var(--shadow-card);}
.booking-box .price-big{font-size:24px;font-weight:800;color:var(--green-deep);}
.field{margin-bottom:14px;}
.field label{display:block;font-size:12.5px;font-weight:700;color:var(--ink-soft);margin-bottom:6px;}
.field input,.field select,.field textarea{
  width:100%;border:1px solid var(--line);border-radius:var(--radius-sm);padding:10px 12px;font-family:inherit;font-size:14.5px;
}
.field textarea{resize:vertical;min-height:70px;}
.total-line{display:flex;justify-content:space-between;font-size:14px;padding:6px 0;}
.total-line.grand{font-weight:800;font-size:16px;border-top:1px solid var(--line);margin-top:6px;padding-top:10px;}

/* ---------- Forms / Auth ---------- */
.auth-shell{max-width:420px;margin:60px auto;background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:34px;box-shadow:var(--shadow-card);}
.auth-shell h1{font-size:24px;margin:0 0 6px;}
.auth-shell p.sub{color:var(--ink-soft);font-size:14px;margin:0 0 24px;}
.role-toggle{display:flex;gap:8px;margin-bottom:18px;background:var(--green-soft);padding:4px;border-radius:999px;}
.role-toggle a{flex:1;text-align:center;padding:8px;border-radius:999px;font-size:13.5px;font-weight:700;color:var(--green-deep);}
.role-toggle a.active{background:#fff;box-shadow:var(--shadow-card);}

/* ---------- Alerts ---------- */
.alert{padding:12px 16px;border-radius:var(--radius-sm);font-size:14px;margin-bottom:16px;}
.alert-error{background:#fbe8e4;color:var(--danger);border:1px solid #f2c6ba;}
.alert-success{background:var(--green-soft);color:var(--green-deep);border:1px solid #cfe3d1;}

/* ---------- Dashboard (owner) ---------- */
.dash-shell{display:grid;grid-template-columns:230px 1fr;gap:0;min-height:70vh;}
.dash-side{background:var(--green-deep);color:#fff;padding:26px 16px;}
.dash-side .who{font-size:13px;opacity:.7;margin-bottom:18px;}
.dash-side a{display:block;padding:10px 12px;border-radius:var(--radius-sm);font-weight:600;font-size:14px;margin-bottom:4px;color:#fff;opacity:.85;}
.dash-side a:hover,.dash-side a.active{background:rgba(255,255,255,0.12);opacity:1;}
.dash-main{padding:30px 34px;background:var(--paper);}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px;}
.stat-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:18px;box-shadow:var(--shadow-card);}
.stat-card .num{font-size:26px;font-weight:800;color:var(--green-deep);}
.stat-card .lbl{font-size:12.5px;color:var(--ink-soft);font-weight:600;margin-top:2px;}
.stat-card.gold .num{color:var(--gold-dark);}

table.data-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;}
table.data-table th{background:var(--green-soft);text-align:left;padding:11px 14px;font-size:12.5px;text-transform:uppercase;letter-spacing:.03em;color:var(--green-deep);}
table.data-table td{padding:12px 14px;border-top:1px solid var(--line);font-size:14px;vertical-align:middle;}
table.data-table tr:hover td{background:#fbfaf5;}
.pill{padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;display:inline-block;}
.pill-pending{background:#FCEFD1;color:#8A5D00;}
.pill-approved,.pill-accepted,.pill-active,.pill-completed{background:#DCEEDD;color:#1F6D33;}
.pill-rejected,.pill-cancelled,.pill-locked{background:#FBE0DB;color:#B23A24;}
.pill-hidden{background:#E7E7E7;color:#555;}

.card-box{background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:22px;box-shadow:var(--shadow-card);margin-bottom:22px;}
.card-box h3{margin:0 0 16px;font-size:16px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.form-grid .full{grid-column:1/-1;}

/* ---------- Footer ---------- */
.footer{background:var(--green-deep);color:#cfe0d4;padding:44px 0 24px;margin-top:40px;font-size:13.5px;}
.footer .container{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px;}
.footer h5{color:#fff;font-size:14px;margin:0 0 12px;}
.footer a{opacity:.8;display:block;padding:4px 0;}
.footer a:hover{opacity:1;text-decoration:underline;}
.footer .bottom{border-top:1px solid rgba(255,255,255,0.12);margin-top:30px;padding-top:18px;opacity:.65;font-size:12.5px;}

/* ---------- Utility ---------- */
.empty-state{text-align:center;padding:60px 20px;color:var(--ink-soft);}
.empty-state .ico{font-size:40px;margin-bottom:10px;}
.flex-between{display:flex;justify-content:space-between;align-items:center;}
.mt-0{margin-top:0;}
.small{font-size:12.5px;color:var(--ink-soft);}

/* ---------- Steps & Marketing Sections ---------- */
.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:0;position:relative;}
.step-card{
  background:#fff;border-radius:var(--radius-md);border:1px solid var(--line);
  padding:26px 20px;box-shadow:var(--shadow-card);transition:.15s ease;
}
.step-card:hover{transform:translateY(-3px);border-color:var(--gold);}
.step-card .step-num{
  width:42px;height:42px;border-radius:50%;background:var(--green-soft);color:var(--green-deep);
  font-weight:800;font-size:18px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;
}

.cta-banner{
  background:linear-gradient(135deg,var(--green-deep) 0%,var(--green-mid) 100%);
  color:#fff;border-radius:var(--radius-lg);padding:48px 36px;
  display:flex;justify-content:space-between;align-items:center;gap:30px;
  box-shadow:var(--shadow-pop);position:relative;overflow:hidden;
}
.cta-banner h2{font-size:28px;font-weight:800;margin:0 0 8px;}
.cta-banner p{margin:0;opacity:.9;font-size:15px;max-width:580px;}

/* Marketing Subpages */
.marketing-hero{
  background:linear-gradient(120deg,var(--green-deep) 0%,var(--green-mid) 100%);
  color:#fff;padding:60px 0 70px;text-align:center;
}
.marketing-hero h1{font-size:38px;font-weight:800;margin:0 0 12px;letter-spacing:-0.02em;}
.marketing-hero p.lead{font-size:17px;opacity:.9;max-width:640px;margin:0 auto;}

.marketing-section{padding:56px 0;}
.marketing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.feature-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);
  padding:26px;box-shadow:var(--shadow-card);
}
.feature-card .icon{font-size:36px;margin-bottom:14px;}
.feature-card h3{font-size:18px;font-weight:700;margin:0 0 8px;}
.feature-card p{color:var(--ink-soft);font-size:14px;margin:0;line-height:1.5;}

.pricing-table{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:20px;}
.pricing-card{
  background:#fff;border:2px solid var(--line);border-radius:var(--radius-lg);
  padding:32px;box-shadow:var(--shadow-card);position:relative;
}
.pricing-card.featured{border-color:var(--gold);background:linear-gradient(180deg,#fff 0%,#fffdf5 100%);}
.pricing-card .badge-plan{
  position:absolute;top:-12px;right:24px;background:var(--gold);color:var(--green-deep);
  padding:4px 14px;border-radius:999px;font-weight:800;font-size:12px;text-transform:uppercase;
}
.pricing-card h3{font-size:22px;margin:0 0 6px;}
.pricing-card .price-tag{font-size:36px;font-weight:800;color:var(--green-deep);margin:14px 0;}
.pricing-card .price-tag span{font-size:14px;font-weight:500;color:var(--ink-soft);}

@media (max-width:1000px){
  .cat-grid{grid-template-columns:repeat(3,1fr);}
  .card-grid{grid-template-columns:repeat(2,1fr);}
  .search-card{grid-template-columns:1fr 1fr;}
  .search-layout{grid-template-columns:1fr;}
  .detail-grid{grid-template-columns:1fr;}
  .dash-shell{grid-template-columns:1fr;}
  .footer .container{grid-template-columns:1fr 1fr;}
  .steps-grid,.marketing-grid,.pricing-table{grid-template-columns:1fr;}
  .cta-banner{flex-direction:column;text-align:center;}
}
